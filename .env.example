# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Square — use Sandbox credentials for local dev; swap to CJ Lavender's
# production values at launch per docs/launch-runbook.md.
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity — filled in during Task 3 (npx sanity init)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=

# CloudWatch RUM — filled at deploy (Task 12 / launch runbook).
# All three must be set for analytics to run; with any of them missing the
# <Rum/> component renders nothing and loads no analytics code at all.
NEXT_PUBLIC_RUM_APP_MONITOR_ID=
NEXT_PUBLIC_RUM_IDENTITY_POOL_ID=
NEXT_PUBLIC_RUM_REGION=

# ---------------------------------------------------------------------------
# Fixture switches — DEVELOPMENT ONLY. Leave both unset here.
#
#   SANITY_FAKE=1  serves the in-repo content fixtures (lib/sanity/fixtures.ts)
#   SQUARE_FAKE=1  serves the in-repo catalog fixtures (lib/square/fixtures.ts)
#
# Together they run the whole site — shop, cart, checkout handoff, blog,
# circles — with no accounts and no credentials at all:
#
#   SANITY_FAKE=1 SQUARE_FAKE=1 npm run dev
#
# The Playwright suite sets them itself (playwright.config.ts). They must never
# be set in Amplify: a deployed build with either one on would serve invented
# products at invented prices.
# ---------------------------------------------------------------------------
